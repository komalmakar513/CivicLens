PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/civiclens
JWT_SECRET=change_this_to_a_long_random_string
# SMTP (used to send the email verification code)
# Gmail: enable 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=CivicLens <your_email@gmail.com>